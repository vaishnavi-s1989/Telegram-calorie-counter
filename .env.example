# ============================================================
# Environment Variables Template
# Copy to .env for local development:  cp .env.example .env
#
# On IBM Code Engine these are set via Secrets and ConfigMaps —
# do NOT commit a populated .env file to source control.
# ============================================================

# ------------------------------------------------------------
# Telegram Bot (REQUIRED)
# Get from @BotFather on Telegram
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ------------------------------------------------------------
# Webhook vs Polling mode
#
# Local development  : WEBHOOK_MODE=false  (polling via run_bot.py)
# IBM Code Engine    : WEBHOOK_MODE=true   (webhook via FastAPI /webhook)
# ------------------------------------------------------------
WEBHOOK_MODE=false

# Public HTTPS URL assigned by IBM Code Engine after first deploy.
# Format: https://<app-name>.<random-hash>.<region>.codeengine.appdomain.cloud
# Leave empty for local development.
WEBHOOK_URL=

# Random secret token to validate Telegram webhook requests.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty for local development.
WEBHOOK_SECRET=

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
DEBUG=true

# IBM Code Engine routes traffic to port 8080.
# Local development uses 8000 (run_api.py overrides this).
PORT=8080

# ------------------------------------------------------------
# Database
#
# Local development  : SQLite (default, no setup needed)
# IBM Code Engine    : IBM Databases for PostgreSQL
#
# PostgreSQL URL format (from IBM Cloud service credentials):
#   postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
#
# To get the URL from IBM Cloud:
#   1. Open IBM Cloud dashboard
#   2. Go to your "Databases for PostgreSQL" instance
#   3. Click "Service credentials" -> "New credential"
#   4. Copy the "connection.postgres.composed" value
# ------------------------------------------------------------
DATABASE_URL=sqlite:///./calorie_tracker.db

# ------------------------------------------------------------
# IBM Cloud — Container Registry (build/push phase only)
# Not needed at runtime inside the container.
# ------------------------------------------------------------
IBM_CLOUD_REGION=us-south
IBM_CR_NAMESPACE=your_icr_namespace_here

# ------------------------------------------------------------
# External APIs (optional)
# ------------------------------------------------------------
OPEN_FOOD_FACTS_API_URL=https://world.openfoodfacts.org/api/v0